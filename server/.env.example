PORT=8787
HOST=127.0.0.1
# Comma-separated exact origins. Local Vite origin is the conservative default.
APP_ORIGINS=http://localhost:5173
NODE_ENV=development
# In-memory fixed-window per-peer-IP limit for all /api/* requests (including health/preflight).
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=10
# Optional server-side key; leave blank unless intentionally performing an approved live inference check.
# Put a real key only in the ignored server/.env or hosting secret store; never commit it.
NVIDIA_API_KEY=
# Generate a 32-byte random base64url token for personal access. Keep the value
# only in the backend environment; never commit a real value or expose it in VITE_*.
FLOW_COMPILER_ACCESS_TOKEN=
NVIDIA_TIMEOUT_MS=90000
NVIDIA_MAX_RESPONSE_BYTES=1048576
